# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database — PostgreSQL (open source)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/defenddaily
REDIS_URL=redis://localhost:6379

# Slack (free tier covers all dev/testing needs)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_STATE_SECRET=...  # random string, min 32 chars in production

# Microsoft Teams (free for dev via Azure portal)
TEAMS_APP_ID=...
TEAMS_APP_PASSWORD=...

# TextBelt — open source SMS gateway (https://github.com/typpo/textbelt, MIT)
# Free public tier: key "textbelt" = 1 SMS/day per IP (dev/testing).
# Production: self-host via `docker run textbelt/textbelt` and set TEXTBELT_API_URL to your instance.
# Explicit smishing_consent_at is required before any send.
TEXTBELT_API_URL=https://textbelt.com
TEXTBELT_API_KEY=textbelt

# SMTP — used for phish simulations AND transactional email (breach alerts, family summaries).
# Use any free SMTP server: self-hosted Postfix/Mailhog for dev, or Gmail/Outlook with app passwords.
# Mailhog for local dev: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=alerts@defenddaily.com
PHISH_FROM_DOMAIN=mail.defenddaily.com

# Canarytokens — open source honey-token service (https://github.com/thinkst/canarytokens, MIT)
# No API key needed for basic tokens. Set this to your public API URL.
CANARY_WEBHOOK_BASE=https://api.defenddaily.com/webhooks/canary

# Phish tracking (public-facing click/open tracking domain)
TRACKING_BASE_URL=http://localhost:3001

# Dashboard auth — NextAuth.js (MIT)
NEXTAUTH_SECRET=...
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# MinIO — open source S3-compatible object storage (https://github.com/minio/minio, AGPL)
# Self-host: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
# Used for compliance PDFs and canary zip downloads.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=defenddaily

# Keycloak — open source enterprise identity provider (https://github.com/keycloak/keycloak, Apache 2.0)
# Phase 6 only — OIDC/SAML SSO for enterprise customers.
# Self-host: docker run -p 8080:8080 quay.io/keycloak/keycloak start-dev
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=defenddaily
KEYCLOAK_CLIENT_ID=...
KEYCLOAK_CLIENT_SECRET=...
